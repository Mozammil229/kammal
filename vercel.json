{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}